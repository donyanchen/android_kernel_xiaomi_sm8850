# Pudding Kernel — 补充 CONFIG（高通开源子系统）
#
# 用途：补齐 upstream 类导出符号（cfg80211 / ipa3 / rmnet / mhi / audio / coresight）
# 追加到 pudding_defconfig 末尾

# ---- 无线 ----
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_QCOM=y

# ---- 网络加速 ----
CONFIG_IPA3=y
CONFIG_GSI=y
CONFIG_RMNET_IPA3=y

# ---- 总线 / 传输 ----
CONFIG_MHI_BUS=y
CONFIG_MHI_BUS_PCI_GENERIC=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_GLINK=y
CONFIG_QCOM_SMD_RPM=y

# ---- 音频 ----
CONFIG_SND_SOC_WCD_MBHC=y
CONFIG_SND_SOC_WCD938X=y
CONFIG_SND_SOC_WSA883X=y
CONFIG_SND_SOC_WSA884X=y
CONFIG_SLIMBUS=y
CONFIG_SOUNDWIRE=y
CONFIG_SWRM=y
CONFIG_QCOM_Q6V5_PAS=y

# ---- 调试跟踪 ----
CONFIG_CORESIGHT=y
CONFIG_CORESIGHT_LINK_AND_SINK_TMC=y
CONFIG_CORESIGHT_STM=y
CONFIG_CORESIGHT_CTI=y
CONFIG_HWSPINLOCK=y
