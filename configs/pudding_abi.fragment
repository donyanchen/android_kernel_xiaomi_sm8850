# ================================================================
# Pudding Kernel — ABI 严格对齐片段
#
# 依据：小米17 (pudding/canoe, sm8850) 原厂固件 OS4.0.5.0.XPCCNXM
#   · /proc/config.gz            (2369 项确定配置)
#   · /sys/kernel/kheaders.tar.xz (autoconf.h 交叉验证)
#   · /sys/kernel/btf/vmlinux    (struct module 1600B / 75 成员)
#   · 原厂 boot.img 内核 + 404 个厂商 .ko 的 __versions
#
# 目的：让 module_layout 等核心符号 CRC 与原厂一致，
#       使 404 个厂商模块可以正常加载。
# 原则：本文件只做「对齐」，不添加任何会改变 struct module 布局的项。
# ================================================================

# ---------------------------------------------------------------- ① modversions 体系
# 原厂 autoconf.h: #define CONFIG_EXTENDED_MODVERSIONS 1
# 影响：__versions 段结构、CRC 存放位置（EXTENDED 模式下 CRC 并入 __ksymtab）
CONFIG_MODVERSIONS=y
CONFIG_EXTENDED_MODVERSIONS=y

# 原厂 autoconf.h: #define CONFIG_CFI_ICALL_NORMALIZE_INTEGERS 1
# 影响：CFI 间接调用归一化，改变函数类型编码 → 影响部分符号 CRC
CONFIG_CFI_CLANG=y
CONFIG_CFI_ICALL_NORMALIZE_INTEGERS=y

# ---------------------------------------------------------------- ② 符号裁剪
# 原厂 autoconf.h: #define CONFIG_TRIM_UNUSED_KSYMS 1
# 影响：ksymtab 只保留白名单内符号，导出符号集合从 25k 降到 14.7k
# 注意：必须同时提供白名单，否则厂商模块依赖的符号会被裁掉
CONFIG_TRIM_UNUSED_KSYMS=y
CONFIG_UNUSED_KSYMS_WHITELIST="abi_symbollist.raw"

# ---------------------------------------------------------------- ③ struct module 布局
# 原厂 BTF: struct module = 1600 字节 / 75 成员
# 以下三项各自引入字段，缺一项布局就变，module_layout CRC 必错
#
#   +256  scmversion        ← CONFIG_MODULE_SCMVERSION
#   +1364 btf_base_data_size← CONFIG_DEBUG_INFO_BTF_MODULES
#   +1568 __kabi_reserved1..4 ← GKI KABI 保留位
CONFIG_MODULE_SCMVERSION=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_MODULE_ALLOW_BTF_MISMATCH=y

# 原厂 config.gz: CONFIG_MODULE_SIG_PROTECT=y
# 影响：struct module 内签名校验相关字段
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA1=y
CONFIG_MODULE_SIG_PROTECT=y
CONFIG_MODULE_SIG_FORMAT=y

# ---------------------------------------------------------------- ④ Rust
# 原厂 autoconf.h: CONFIG_RUST=1 / RUSTC_VERSION=108200
# 影响：Rust 编译进内核后导出 3655 个 _RNv* 符号，
#       且 kernel crate 的 struct 参与 BTF
# 注意：需要 rust 1.82 工具链 + bindgen，CI 中必须预装
CONFIG_RUST=y
CONFIG_RUST_IS_AVAILABLE=y

# ---------------------------------------------------------------- ⑤ 内核自省
# 让产物也内嵌 .config，便于事后校验（原厂同样开启）
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# ---------------------------------------------------------------- ⑥ 版本串
# 原厂: CONFIG_LOCALVERSION="-4k" + LOCALVERSION_AUTO=y
#      → 最终 vermagic = 6.12.69-android16-6-g<commit>-abogki<N>-4k
# 我们固定成 "-android16-6-4k"，保证 vermagic 平台段完全一致
CONFIG_LOCALVERSION="-android16-6-4k"
CONFIG_LOCALVERSION_AUTO=n

# ---------------------------------------------------------------- ⑦ 自定义功能（不影响 ABI）
CONFIG_KSU=y
CONFIG_KPM=y
