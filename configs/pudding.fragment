# Pudding Kernel 配置片段
#
# 追加到 arch/arm64/configs/gki_defconfig 末尾。
# 注意：官方 gki_defconfig 已包含 SCHED_CLASS_EXT / LRU_GEN / FQ_CODEL / BPF_LSM /
#       KVM / PSI / UCLAMP_TASK_GROUP / OVERLAY_FS 等，这里只加相对基线缺失的项。

# ================================================================ 版本
# 决定 vermagic，必须与设备 vendor 模块一致，勿改
CONFIG_LOCALVERSION="-android16-6-4k"
CONFIG_LOCALVERSION_AUTO=n

# ================================================================ Root / KPM
CONFIG_KSU=y
CONFIG_KPM=y
CONFIG_KALLSYMS_ALL=y

# ================================================================ 编译优化
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# ================================================================ 调度
CONFIG_UCLAMP_BUCKETS_COUNT=20

# ================================================================ 内存
CONFIG_ZSWAP=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
# 数据访问监控（自适应回收）
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_SYSFS=y
CONFIG_DAMON_LRU_SORT=y
# 内存去重（谨慎：耗CPU）
CONFIG_KSM=y

# ================================================================ IO
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y

# ================================================================ 网络
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
# 队列规则
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_BPF=y
# netfilter 扩展（广告拦截 / 代理 / 流量整形）
CONFIG_NETFILTER_XT_SET=y
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=256
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_MATCH_TPROXY=y
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_WIREGUARD=y

# ================================================================ 文件系统
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_NTFS3_FS=y
CONFIG_TMPFS_XATTR=y

# ================================================================ LZ4KD
# lz4 内核差分压缩：zram 后端 + crypto 实现。
# 注意：zram 保持 =m（模块）。改成 =y（内建）会让本机开不了机
# （#117 实测：与 #116 的配置差异只有这一行），而系统加载的又是 vendor_dlkm
# 的 zram.ko，所以 LZ4K/LZ4KD 后端在运行时不会出现于 comp_algorithm。
CONFIG_ZRAM_BACKEND_LZ4K=y
CONFIG_ZRAM_BACKEND_LZ4KD=y
CONFIG_CRYPTO_LZ4K=y
CONFIG_CRYPTO_LZ4KD=y
