# Pudding Kernel 配置片段
#
# 追加到 arch/arm64/configs/gki_defconfig 末尾。
# 说明：GKI 基线已经包含绝大部分标准配置，这里只列出本项目相对基线新增/覆盖的项。

# ---------------------------------------------------------------- 版本
# 决定 vermagic，必须与设备 vendor 模块一致，勿改
CONFIG_LOCALVERSION="-android16-6-4k"
# 关闭自动追加 git 描述，保证 vermagic 稳定
CONFIG_LOCALVERSION_AUTO=n

# ---------------------------------------------------------------- Root / KPM
CONFIG_KSU=y
CONFIG_KPM=y
# KPM 加载模块需要完整符号表
CONFIG_KALLSYMS_ALL=y

# ---------------------------------------------------------------- 调度
# sched_ext 子系统（对应小米 MI_SCHED_EXT 的底层能力）
CONFIG_SCHED_CLASS_EXT=y
# 与小米内核一致的 uclamp 分桶数
CONFIG_UCLAMP_BUCKETS_COUNT=20

# ---------------------------------------------------------------- 内存
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZSWAP=y
CONFIG_ZRAM_WRITEBACK=y

# ---------------------------------------------------------------- IO
CONFIG_MQ_IOSCHED_KYBER=y

# ---------------------------------------------------------------- 网络
CONFIG_TCP_CONG_BBR=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_IP_SET=y
CONFIG_WIREGUARD=y

# ---------------------------------------------------------------- 文件系统
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_EROFS_FS_ZIP=y
